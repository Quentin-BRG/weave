# The cloudflared release every Weave package bundles.
#
# `src/install.rs` carries the same string as `install::CLOUDFLARED_VERSION`,
# and `tests/packaging.rs` fails if the two drift apart. Bumping cloudflared
# therefore means editing three things together: this file, `SHA256SUMS`, and
# that constant.
#
# Sourced by every packaging script (`. packaging/cloudflared/pinned.env`), so
# keep it plain `KEY=value` with no shell beyond that.

CLOUDFLARED_VERSION=2026.8.2
CLOUDFLARED_BASE_URL=https://github.com/cloudflare/cloudflared/releases/download
